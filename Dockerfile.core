FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    RUNE_API_HOST=0.0.0.0

WORKDIR /app
COPY pyproject.toml ./
COPY rune ./rune
RUN apt-get update \
    && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir . \
    && mkdir -p /app/data \
    && useradd --create-home --uid 10001 rune

COPY docker/core-entrypoint.sh /usr/local/bin/rune-entrypoint
RUN chmod 0755 /usr/local/bin/rune-entrypoint

USER root
VOLUME ["/app/data"]
ENTRYPOINT ["/usr/local/bin/rune-entrypoint"]
CMD ["rune-api"]

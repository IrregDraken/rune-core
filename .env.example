# R.U.N.E integration configuration
# Copy to .env locally. Never commit real credentials.
# All connectors remain inactive until credentials, scopes and adapters are configured.

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Notion
NOTION_API_TOKEN=

# Web research
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Developer platforms
GITHUB_TOKEN=
GITLAB_TOKEN=
FIGMA_ACCESS_TOKEN=
LINEAR_API_KEY=
SENTRY_AUTH_TOKEN=
VERCEL_TOKEN=
RAILWAY_API_TOKEN=

# Collaboration and messaging
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=

# WhatsApp Business Platform only
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Meta apps: Instagram / Facebook / Threads, subject to product permissions
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Snapchat public/marketing API surfaces only, if approved
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Other social APIs
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Media and research libraries
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# Business and productivity alternatives
HUBSPOT_ACCESS_TOKEN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Smart home / later Android companion
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# AI media services
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Local R.U.N.E session protection
RUNE_SESSION_TOKEN=

# Additional connector credentials (leave blank until provider authorisation)
META_GRAPH_VERSION=
PINTEREST_ACCESS_TOKEN=

# Messaging and social API version/access-token configuration
WHATSAPP_API_VERSION=
LINKEDIN_API_VERSION=
TIKTOK_ACCESS_TOKEN=

# Optional administrator-managed MCP server registry (JSON array; no secrets inline)
RUNE_MCP_SERVERS_JSON=

# Browser remains disabled until outbound egress filtering is enforced by the host
RUNE_BROWSER_EGRESS_POLICY=
SLACK_USER_TOKEN=
RUNE_CONSENT_DB=
YOUTUBE_API_KEY=

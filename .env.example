# RUNE Core
RUNE_MODEL_MODE=development
RUNE_SESSION_TOKEN=
# Enable for any remotely hosted core API. /api/health remains public.
RUNE_API_AUTH_REQUIRED=false

# Model provider routing. Set live mode only after verifying model IDs and
# current per-million prices from the provider's official pricing pages.
RUNE_MONTHLY_MODEL_BUDGET_USD=33
RUNE_PRIMARY_KIND=openai
RUNE_PRIMARY_NAME=primary
RUNE_PRIMARY_MODEL=
RUNE_PRIMARY_API_KEY_ENV=RUNE_PRIMARY_API_KEY
RUNE_PRIMARY_INPUT_USD_PER_MILLION=
RUNE_PRIMARY_OUTPUT_USD_PER_MILLION=
RUNE_PRIMARY_MAX_OUTPUT_TOKENS=800
RUNE_PRIMARY_API_KEY=

# Optional fallback. kind may be openai or anthropic.
RUNE_FALLBACK_KIND=anthropic
RUNE_FALLBACK_NAME=fallback
RUNE_FALLBACK_MODEL=
RUNE_FALLBACK_API_KEY_ENV=RUNE_FALLBACK_API_KEY
RUNE_FALLBACK_INPUT_USD_PER_MILLION=
RUNE_FALLBACK_OUTPUT_USD_PER_MILLION=
RUNE_FALLBACK_MAX_OUTPUT_TOKENS=800
RUNE_FALLBACK_API_KEY=

# Remote backend control plane. Owner access token is short-lived and should
# be injected by a secure session manager, not committed to source control.
RUNE_REMOTE_BACKEND_URL=
RUNE_OWNER_ACCESS_TOKEN=
RUNE_OWNER_ACCESS_TOKEN_EXPIRES_AT=
RUNE_OWNER_REFRESH_TOKEN=
# Generate a random 32-byte key and URL-safe-base64 encode it.
# Keep this key in the deployment secret manager, never in source control.
RUNE_OWNER_TOKEN_ENCRYPTION_KEY=
RUNE_OWNER_SESSION_DB=data/rune-owner-session.db

# OpenAI speech recognition for completed utterances. Use gpt-transcribe.
RUNE_OPENAI_STT_API_KEY=
RUNE_OPENAI_STT_MODEL_ID=gpt-transcribe

# ElevenLabs voice output. Voice ID is selected after auditioning candidates.
ELEVENLABS_API_KEY=
RUNE_ELEVENLABS_VOICE_ID=
RUNE_ELEVENLABS_MODEL_ID=eleven_flash_v2_5
RUNE_ELEVENLABS_MONTHLY_CHAR_LIMIT=10000
RUNE_VOICE_USAGE_DB=data/rune-voice-usage.db

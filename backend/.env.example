# Local development: set to production in hosted environments to disable API docs.
RUNE_BACKEND_ENV=development
RUNE_BACKEND_HOST=127.0.0.1
RUNE_BACKEND_PORT=8787
RUNE_BACKEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dedicated RUNE Supabase project only.
RUNE_SUPABASE_URL=
RUNE_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Never place this in the mobile app or source control.
RUNE_SUPABASE_SECRET_KEY=
